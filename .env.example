# --- Supabase (auth, database, storage). Leave blank to run in demo-only mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: webhooks, account deletion

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CROSSREF_MAILTO=                    # optional: joins Crossref's polite pool for DOI lookups

# --- Plans (display only; prices are never hardcoded) ---
NEXT_PUBLIC_PRICE_LABEL_STANDARD=   # e.g. "Free"
NEXT_PUBLIC_PRICE_LABEL_PREMIUM=    # e.g. "$6 / month" — must match your Stripe price
NEXT_PUBLIC_PREMIUM_STORAGE_GB=20

# --- Stripe Billing (all four + service role key required to enable upgrades) ---
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
